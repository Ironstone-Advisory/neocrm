{
  "name": "neocrm",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-native relationship management architecture and bounded experiments",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "check:contracts": "node scripts/generate-contracts.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:spec": "node scripts/validate-spec.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:article": "node scripts/check-article-claims.mjs",
    "test": "node --test",
    "eval": "node evals/run-eval.mjs",
    "check": "pnpm validate:spec && pnpm check:links && pnpm check:article && pnpm check:contracts && pnpm typecheck && pnpm test && pnpm eval",
    "demo": "node apps/assistant/src/cli.mjs",
    "exp:001": "node apps/experiment-cli/src/cli.mjs",
    "exp:001:preflight": "node apps/experiment-cli/src/cli.mjs --preflight"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.7.3"
  }
}
