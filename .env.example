# EXP-001 live mode is opt-in. Copy to .env outside version control and load it
# in your shell; this repository does not auto-read dotenv files.
NEOCRM_ZOHO_REGION=ca
NEOCRM_ZOHO_ACCESS_TOKEN=
# Optional refresh flow (used only when no access token is supplied):
NEOCRM_ZOHO_REFRESH_TOKEN=
NEOCRM_ZOHO_CLIENT_ID=
NEOCRM_ZOHO_CLIENT_SECRET=
# Optional diagnostics/overrides; when set they MUST exactly match the selected
# region's registered Zoho API and OAuth boundaries or preflight fails closed:
NEOCRM_ZOHO_API_BASE_URL=
NEOCRM_ZOHO_TOKEN_URL=
# Optional modules are comma-separated and remain read-only:
NEOCRM_ZOHO_OPTIONAL_MODULES=

NEOCRM_OBSIDIAN_VAULT_ROOT=C:\path\to\vault
NEOCRM_OBSIDIAN_APPROVED_DIRS=relationships
NEOCRM_OBSIDIAN_APPROVED_TAGS=neocrm,exp-001
